# Copy to .env.docker — uses PostgreSQL on your machine (not a Docker db container).
# Match DATABASE_* with your local DBeaver / runserver settings.

DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=hrms_db_demo1
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Requires Redis on the host (port 6379), not a Docker Redis container.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# --- Email (Celery payslip/notifications call send_email_task) ---
# Local dev default: console backend (see also DEBUG + placeholder host in settings.py)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
# Real SMTP: set EMAIL_BACKEND=smtp.EmailBackend and a real host, e.g.:
# EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

AI_PROVIDER=DUMMY